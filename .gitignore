# ==========================================
# 1. GO & BUILD ARTIFACTS
# ==========================================
# Binary outputs and temporary build dirs
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
build/bin/

# Go test and coverage files
*.test
*.out

# ==========================================
# 2. WAILS & FRONTEND (Node / Svelte)
# ==========================================
# Node dependencies
node_modules/
frontend/node_modules/

# Svelte / Vite build output & cache
frontend/dist/
frontend/.svelte-kit/
.vite/

# Wails auto-generated JS/TS bindings
# (Omit if you track generated frontend bindings in Git)
frontend/bindings/

# NPM / Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. DATABASE & LOCAL DATA
# ==========================================
# Local SQLite database files, WAL logs, and shm files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ==========================================
# 4. EDITORS & OS (Neovim, Windows, OS X)
# ==========================================
# Neovim swap, undo, and session files
*.swp
*.swo
*~
.netrwhist

# Windows system files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS system files
.DS_Store

# Environment variables & local secrets
.env
.env.local
.env.*.local
